{
  "type": "tabs",
  "i18n": true,
  "items": {
    "general": {
      "type": "panel",
      "label": {
        "en": "General",
        "de": "Allgemein"
      },
      "items": {
        "enabled": {
          "type": "checkbox",
          "label": {
            "en": "Enable status list",
            "de": "Statusanzeigeliste aktivieren"
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "includeDate": {
          "type": "checkbox",
          "label": {
            "en": "Show start date before message",
            "de": "Startdatum vor Meldung anzeigen"
          },
          "help": {
            "en": "If enabled, the date when the message first became active is prepended with a trailing space.",
            "de": "Wenn aktiv, wird das Datum der ersten Aktivierung mit nachfolgendem Leerzeichen vor die Meldung gesetzt."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "includeTime": {
          "type": "checkbox",
          "label": {
            "en": "Show start time before message",
            "de": "Startzeit vor Meldung anzeigen"
          },
          "help": {
            "en": "If enabled, the time when the message first became active is prepended with a trailing space.",
            "de": "Wenn aktiv, wird die Uhrzeit der ersten Aktivierung mit nachfolgendem Leerzeichen vor die Meldung gesetzt."
          },
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "emptyText": {
          "type": "text",
          "label": {
            "en": "Text if no message is active",
            "de": "Text wenn keine Meldung aktiv ist"
          },
          "xs": 12,
          "sm": 8,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "rowClass": {
          "type": "text",
          "label": {
            "en": "CSS class for message rows",
            "de": "CSS-Klasse fuer Meldungszeilen"
          },
          "xs": 12,
          "sm": 4,
          "md": 3,
          "lg": 3,
          "xl": 3
        },
        "archiveEnabled": {
          "type": "checkbox",
          "label": {
            "en": "Enable message archive",
            "de": "Meldungsarchiv aktivieren"
          },
          "help": {
            "en": "Stores a coming and going event for every status transition.",
            "de": "Speichert fuer jeden Statuswechsel ein Gekommen- und ein Gegangen-Ereignis."
          },
          "default": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "archiveMaxEntries": {
          "type": "number",
          "label": {
            "en": "Maximum archive entries",
            "de": "Maximale Anzahl Archiveintraege"
          },
          "help": {
            "en": "Oldest events are automatically removed when this limit is exceeded.",
            "de": "Die aeltesten Ereignisse werden beim Ueberschreiten automatisch entfernt."
          },
          "min": 1,
          "max": 10000,
          "default": 500,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "emailInstance": {
          "type": "text",
          "label": {
            "en": "Email adapter instance",
            "de": "E-Mail-Adapterinstanz"
          },
          "help": {
            "en": "Existing ioBroker email instance used for archive delivery, for example email.0.",
            "de": "Vorhandene ioBroker-E-Mail-Instanz fuer den Archivversand, zum Beispiel email.0."
          },
          "default": "email.0",
          "xs": 12,
          "sm": 4,
          "md": 3,
          "lg": 3,
          "xl": 3
        },
        "emailRecipient": {
          "type": "text",
          "label": {
            "en": "Archive email recipient",
            "de": "Empfaenger fuer Archiv-E-Mail"
          },
          "help": {
            "en": "Optional. If empty, the default recipient configured in the email adapter is used.",
            "de": "Optional. Wenn leer, wird der im E-Mail-Adapter konfigurierte Standardempfaenger verwendet."
          },
          "xs": 12,
          "sm": 4,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "emailSubject": {
          "type": "text",
          "label": {
            "en": "Archive email subject",
            "de": "Betreff der Archiv-E-Mail"
          },
          "default": "ioBroker Meldungsarchiv",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        }
      }
    },
    "rulesTab": {
      "type": "panel",
      "label": {
        "en": "Rules",
        "de": "Regeln"
      },
      "items": {
        "rules": {
          "type": "table",
          "label": {
            "en": "Status rules",
            "de": "Status-Regeln"
          },
          "import": true,
          "export": true,
          "showSecondAddAt": 10,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "items": [
            {
              "attr": "enabled",
              "type": "checkbox",
              "title": {
                "en": "Active",
                "de": "Aktiv"
              },
              "default": true,
              "width": "70px"
            },
            {
              "attr": "name",
              "type": "text",
              "title": {
                "en": "Name",
                "de": "Name"
              },
              "width": "180px"
            },
            {
              "attr": "sourceId",
              "type": "objectId",
              "title": {
                "en": "Source state",
                "de": "Quell-Datenpunkt"
              },
              "width": "330px"
            },
            {
              "attr": "operator",
              "type": "select",
              "title": {
                "en": "Compare",
                "de": "Vergleich"
              },
              "options": [
                { "label": "=", "value": "==" },
                { "label": "!=", "value": "!=" },
                { "label": ">", "value": ">" },
                { "label": ">=", "value": ">=" },
                { "label": "<", "value": "<" },
                { "label": "<=", "value": "<=" },
                { "label": "contains", "value": "contains" }
              ],
              "default": "==",
              "width": "120px"
            },
            {
              "attr": "compareMode",
              "type": "select",
              "title": {
                "en": "With",
                "de": "Mit"
              },
              "options": [
                {
                  "label": {
                    "en": "Fixed value",
                    "de": "Festwert",
                    "ru": "Фиксированное значение",
                    "pt": "Valor fixo",
                    "nl": "Vaste waarde",
                    "fr": "Valeur fixe",
                    "it": "Valore fisso",
                    "es": "Valor fijo",
                    "pl": "Wartość stała",
                    "uk": "Фіксоване значення",
                    "zh-cn": "固定值"
                  },
                  "value": "constant"
                },
                {
                  "label": {
                    "en": "Other state",
                    "de": "Anderer Datenpunkt",
                    "ru": "Другое состояние",
                    "pt": "Outro estado",
                    "nl": "Andere status",
                    "fr": "Autre état",
                    "it": "Altro stato",
                    "es": "Otro estado",
                    "pl": "Inny stan",
                    "uk": "Інший стан",
                    "zh-cn": "其他状态"
                  },
                  "value": "state"
                }
              ],
              "default": "constant",
              "width": "160px"
            },
            {
              "attr": "compareValue",
              "type": "text",
              "title": {
                "en": "Fixed value",
                "de": "Festwert"
              },
              "width": "170px"
            },
            {
              "attr": "compareStateId",
              "type": "objectId",
              "title": {
                "en": "Compare state",
                "de": "Vergleichs-Datenpunkt"
              },
              "width": "330px"
            },
            {
              "attr": "valueType",
              "type": "select",
              "title": {
                "en": "Type",
                "de": "Typ"
              },
              "options": [
                { "label": "auto", "value": "auto" },
                { "label": "number", "value": "number" },
                { "label": "boolean", "value": "boolean" },
                { "label": "string", "value": "string" }
              ],
              "default": "auto",
              "width": "130px"
            },
            {
              "attr": "severity",
              "type": "select",
              "title": {
                "en": "Severity",
                "de": "Prioritaet"
              },
              "options": [
                { "label": "info", "value": "info" },
                { "label": "warning", "value": "warning" },
                { "label": "error", "value": "error" },
                { "label": "ok", "value": "ok" }
              ],
              "default": "info",
              "width": "130px"
            },
            {
              "attr": "text",
              "type": "text",
              "title": {
                "en": "Message text",
                "de": "Meldungstext"
              },
              "width": "360px"
            }
          ]
        }
      }
    }
  }
}
